{
    "manifest_version": 3,
    "default_locale": "en",

    "name": "__MSG_extension_name__",
    "description": "__MSG_extension_description__",
    "version": "1.0",

    "icons": {
        "48": "images/icon-48.png",
        "96": "images/icon-96.png",
        "128": "images/icon-128.png",
        "256": "images/icon-256.png",
        "512": "images/icon-512.png"
    },

    "background": {
        "scripts": [ "background.js" ],
        "type": "module"
    },

    "content_scripts": [{
        "js": [
            "autofill/matching.js",
            "autofill/catalog.js",
            "autofill/detector.js",
            "autofill/filler.js",
            "autofill/engine.js",
            "autofill/adapters/greenhouse.js",
            "autofill/adapters/ashby.js",
            "autofill/adapters/gem.js",
            "autofill/adapters/workday.js",
            "content.js"
        ],
        "matches": [
            "*://*.ashbyhq.com/*", "*://ashbyhq.com/*",
            "*://*.greenhouse.io/*", "*://greenhouse.io/*",
            "*://jobs.gem.com/*",
            "*://*.myworkdayjobs.com/*", "*://*.myworkdaysite.com/*"
        ],
        "all_frames": true
    }],

    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "images/icon-48.png",
            "32": "images/icon-48.png",
            "48": "images/icon-48.png",
            "96": "images/icon-96.png",
            "128": "images/icon-128.png"
        }
    },

    "permissions": [ "storage", "activeTab", "nativeMessaging" ]
}
